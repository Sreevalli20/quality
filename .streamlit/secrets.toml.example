# Copy this file to .streamlit/secrets.toml and fill in your own key.
# secrets.toml is gitignored - never commit real keys.
#
# Optional: enables the Gemini-powered narrative briefing in the
# Personal AI Assistant. Everything works without it (rule engine only).

GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-2.0-flash"   # optional; this is the default
