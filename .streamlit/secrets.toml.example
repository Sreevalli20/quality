# Copy this file to .streamlit/secrets.toml and fill in your own keys.
# secrets.toml is gitignored - never commit real keys.
#
# Everything below is OPTIONAL. The app runs fully without any secrets;
# each integration degrades gracefully and is labelled honestly.

# --- Optional: live air-quality data (OpenAQ v3) -------------------------
# Enables "Fetch live monitoring data" on the Home page and shows provider
# health on the About page. Get a free key at https://openaq.org
OPENAQ_API_KEY = "your-openaq-api-key-here"

# --- Optional: generative-AI narrative briefing --------------------------
# Enables the "Generate AI briefing" button in Personal AI Assistant.
# Output is always labelled AI-generated; the rule engine is the foundation.
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-2.0-flash"   # optional; this is the default
